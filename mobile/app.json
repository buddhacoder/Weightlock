{
  "expo": {
    "name": "WeightLock",
    "slug": "weightlock",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "newArchEnabled": true,
    "scheme": "weightlock",
    "runtimeVersion": {
      "policy": "appVersion"
    },
    "updates": {
      "url": "https://u.expo.dev/your-project-id"
    },
    "splash": {
      "image": "./assets/splash-icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#059669"
    },
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "com.weightlock.app",
      "infoPlist": {
        "NSCameraUsageDescription": "WeightLock needs camera access to photograph your scale for weigh-in verification."
      }
    },
    "android": {
      "package": "com.weightlock.app",
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#059669"
      },
      "edgeToEdgeEnabled": true,
      "permissions": ["CAMERA"]
    },
    "plugins": [
      "expo-router",
      "expo-secure-store",
      [
        "expo-camera",
        {
          "cameraPermission": "WeightLock needs camera access to photograph your scale."
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "WeightLock needs photo access for scale photo verification."
        }
      ],
      [
        "expo-notifications",
        {
          "sounds": []
        }
      ]
    ]
  }
}
